# =====================================================================
# The Hand Craft Atelier - environment variables
# Copy this file to ".env" and replace the sample values with real ones.
# NEVER commit ".env" to git. Variables starting with VITE_ are exposed to
# the browser (public); everything else is SERVER-ONLY (keep it secret).
# =====================================================================

# ---------- App ----------
NODE_ENV=development
APP_NAME="The Hand Craft Atelier"
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PORT=4000
# Random 32+ char string used to sign sessions / JWTs  (openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string
# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ---------- Cashfree Payments ----------
# Dashboard: https://merchant.cashfree.com -> Developers -> API Keys
CASHFREE_ENV=sandbox                      # sandbox | production
CASHFREE_APP_ID=TEST1234567890abcdef
CASHFREE_SECRET_KEY=cfsk_ma_test_xxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_API_VERSION=2023-08-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg   # production: https://api.cashfree.com/pg
# Cashfree redirects the customer here after payment ({order_id} is filled in by Cashfree)
CASHFREE_RETURN_URL=https://thehandcraftatelier.live/order-success?order_id={order_id}
# Cashfree calls this server URL with payment status updates
CASHFREE_WEBHOOK_URL=https://thehandcraftatelier.live/api/payments/cashfree/webhook
# Public value - safe for the browser (used to choose sandbox/production checkout)
VITE_CASHFREE_MODE=sandbox

# ---------- Supabase (database / auth / storage) ----------
# Dashboard: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample-anon-key
# SERVER-ONLY. Bypasses row level security - never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample-service-role-key
# Direct Postgres connection (migrations / Prisma / Drizzle)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=product-images
# Public copies for the browser app
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample-anon-key

# ---------- Redis (caching, rate limiting, sessions) ----------
REDIS_URL=redis://default:your-password@localhost:6379
# Hosted example (Upstash): rediss://default:xxxx@your-db.upstash.io:6379
REDIS_KEY_PREFIX=atelier:
REDIS_TTL_PRODUCTS=300          # seconds to cache product lists
REDIS_TTL_SESSION=86400         # seconds to keep a session / cart

# ---------- Email (order confirmations, receipts) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey_or_username
SMTP_PASS=your-smtp-password
EMAIL_FROM="The Hand Craft Atelier <orders@thehandcraftatelier.com>"
ADMIN_EMAIL=admin@thehandcraftatelier.com

# ---------- SMS / WhatsApp notifications (phone numbers are collected in the footer) ----------
# Pick one provider, e.g. Twilio, MSG91 or Gupshup
SMS_PROVIDER=msg91
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=ATELIR
WHATSAPP_NUMBER=919XXXXXXXXX             # country code + number, no "+" (used for wa.me link)
VITE_WHATSAPP_NUMBER=919XXXXXXXXX
VITE_INSTAGRAM_URL=https://www.instagram.com/your_handle

# ---------- Shipping ----------
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_EMAIL=you@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
FREE_SHIPPING_THRESHOLD=2000             # INR
FLAT_SHIPPING_FEE=99                     # INR

# ---------- Analytics & monitoring ----------
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=000000000000000
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
