{
  "name": "ronit-design-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" \"public/policies/*.html\" \"scripts/*.mjs\" \"src/data/*.json\" index.html package.json README.md",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"api/**/*.js\" \"public/policies/*.html\" \"scripts/*.mjs\" \"src/data/*.json\" index.html package.json README.md",
    "check:catalog": "node scripts/check-catalog.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "8.3.5"
  }
}
